  m_Script: {fileID: 11500000, guid: 43af71a745db8cf49984c234f252689c, type: 3}
  m_Name: Dialogue_SubQuest1-2
  m_EditorClassIdentifier: ShadowSeller::ShadowSeller.Core.DialogueData
  lines:
  - speakerName: 
    text: "\uC4F0\uB2E4 \uB9CC \uAC83 \uAC19\uC740 \uD3B8\uC9C0\uAC00 \uB193\uC5EC\uC838
      \uC788\uB2E4."
  - speakerName: 
    text: "\uAE09\uD558\uAC8C \uB5A0\uB098\uAE30\uB77C\uB3C4 \uD588\uB294\uC9C0 \uD3B8\uC9C0\uC758
      \uB9C8\uC9C0\uB9C9\uC740 \uC789\uD06C\uAC00 \uAE38\uAC8C \uADF8\uC5B4\uC838
      \uC788\uB2E4."
  - speakerName: 
    text: "(\uADF8 \uC0AC\uB0B4\uB97C \uB9CC\uB09C \uB4A4\uB85C \uBAA8\uB4E0 \uAC83\uC774
      \uC190\uC5D0 \uB4E4\uC5B4\uC654\uB2E4.)"
  - speakerName: 
    text: "(\uADF8\uB9AC\uACE0 \uBAA8\uB4E0 \uAC83\uC774 \uC0AC\uB77C\uC84C\uB2E4.)"
  - speakerName: 
    text: "(\uD639\uC2DC \uADF8 \uC0AC\uB0B4\uB97C \uB9CC\uB09C\uB2E4\uBA74 \uBB34\uC5C7\uC744
      \uAD8C\uD558\uB4E0 \uBC18\uB4DC\uC2DC \uAC70\uC808\uD574\uC57C \uD55C\uB2E4.)"
  - speakerName: 
    text: "(\uD68C...)"
  - speakerName: "\uBBF8\uB098"
    text: "\uD398\uD130, \uC65C \uADF8\uB798\uC694?"
  - speakerName: "\uB098"
    text: "\uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC57C."
