  m_Script: {fileID: 11500000, guid: 43af71a745db8cf49984c234f252689c, type: 3}
  m_Name: Dialogue_Mina2
  m_EditorClassIdentifier: ShadowSeller::ShadowSeller.Core.DialogueData
  lines:
  - speakerName: 
    text: "\uC5B4\uB9B0 \uC2DC\uC808\uCC98\uB7FC, \uC790\uC5F0\uC2A4\uB7FD\uAC8C
      \uC548\uC544\uC8FC\uAE30 \uC704\uD574 \uD314\uC744 \uBC8C\uB9AC\uC790 \uBBF8\uB098\uB294
      \uB2F9\uC5F0\uD558\uB2E4\uB294 \uB4EF\uC774 \uB2E4\uAC00\uC654\uB2E4."
  - speakerName: 
    text: "\uADF8\uB7EC\uB098 \uADF8\uB140\uB294 \uBB38\uB4DD \uAC78\uC74C\uC744
      \uBA48\uCDC4\uB2E4."
  - speakerName: 
    text: "\uADF8\uB140\uC758 \uC2DC\uC120\uC774 \uD398\uD130\uC758 \uBC1C \uBC11\uC73C\uB85C
      \uD5A5\uD588\uB2E4."
  - speakerName: 
    text: "\uC751\uC811\uC2E4\uC758 \uBCBD\uB09C\uB85C\uB85C \uAE38\uAC8C \uC0DD\uACA8\uB098\uB294
      \uADF8\uB9BC\uC790, \uD398\uD130\uC758 \uBC1C \uBC11\uC5D0\uB294 \uC544\uBB34\uAC83\uB3C4
      \uC5C6\uC5C8\uB2E4."
