  m_Script: {fileID: 11500000, guid: 43af71a745db8cf49984c234f252689c, type: 3}
  m_Name: Dialogue_Stage1Start
  m_EditorClassIdentifier: ShadowSeller::ShadowSeller.Core.DialogueData
  lines:
  - speakerName: "\uB098"
    text: "\uC77C\uB2E8 \uADF8\uB9BC\uC790\uC5D0 \uC228\uC5B4 \uC788\uC73C\uBA74
      \uC758\uC2EC\uD558\uC9C4 \uC54A\uACA0\uC9C0. \uBE5B\uC5D0 \uB178\uCD9C\uB418\uBA74
      \uC0AC\uB78C\uB4E4\uC774 \uC758\uC2EC\uD560 \uAC70\uC57C."
  - speakerName: "\uB098"
    text: "\uBE5B\uC744 \uD53C\uD574 \uCD5C\uB300\uD55C \uADF8\uB9BC\uC790\uAC00
      \uBCF4\uC774\uC9C0 \uC54A\uAC8C \uC774\uB3D9\uD574\uC57C\uACA0\uC5B4."
  - speakerName: "\uB098"
    text: "\uC704\uC758 \uD070 \uCC3D\uACE0\uC5D0 \uADF8\uB9BC\uC790\uB97C \uC228\uAE38
      \uB9CC\uD55C \uBB3C\uAC74\uC774 \uC788\uC744\uAE4C? \uD55C \uBC88 \uD655\uC778\uD574\uBCF4\uB294
      \uAC83\uB3C4 \uC88B\uACA0\uC5B4."
