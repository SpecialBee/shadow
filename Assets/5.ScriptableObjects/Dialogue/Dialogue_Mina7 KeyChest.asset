  m_Name: Dialogue_Mina7 KeyChest
  m_EditorClassIdentifier: ShadowSeller::ShadowSeller.Core.DialogueData
  lines:
  - speakerName: 
    text: "\uB0A1\uC740 \uBAA9\uC7AC \uC0C1\uC790, \uB0B4\uBD80\uC5D0\uB294 \uC5F4\uC1E0
      \uAFB8\uB7EC\uBBF8\uAC00 \uB4E4\uC5B4 \uC788\uB2E4."
  - speakerName: "\uBBF8\uB098"
    text: "\uC5F4\uC1E0 \uBCF4\uAD00\uD568\uC774\uC5D0\uC694."
  - speakerName: 
    text: "\uADF8\uB140\uB294 \uC5EC\uB7EC \uAC1C\uC758 \uC5F4\uC1E0\uAC00 \uAC78\uB9B0
      \uC5F4\uC1E0 \uAFB8\uB7EC\uBBF8\uB97C \uD558\uB098\uD558\uB098 \uC0B4\uD3B4
      \uBCF4\uC558\uB2E4."
  - speakerName: 
    text: "\uADF8\uC911 \uD558\uB098\uC5D0 \"2\uCE35 \uACC4\uB2E8\"\uC774\uB77C\uB294
      \uB77C\uBCA8\uC774 \uBD99\uC5B4 \uC788\uB2E4."
  - speakerName: "\uBBF8\uB098"
    text: "\uCC3E\uC558\uC5B4\uC694!"
