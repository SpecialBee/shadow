MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 43af71a745db8cf49984c234f252689c, type: 3}
  m_Name: Dialogue_Mina9 CrossRoad
  m_EditorClassIdentifier: ShadowSeller::ShadowSeller.Core.DialogueData
  lines:
  - speakerName: 
    text: "\uC67C\uCABD \uBCF5\uB3C4\uC5D0\uC11C \uB2EC\uAC11\uC9C0 \uC54A\uC740
      \uBC1C\uC18C\uB9AC\uAC00 \uB4E4\uB824\uC654\uB2E4."
  - speakerName: "\uACBD\uBE44"
    text: "\uC774\uCABD\uC5D0\uC11C\uBD80\uD130 \uC800\uAE30\uAE4C\uC9C0 \uBA3C\uC800
      \uB2E4 \uD655\uC778\uD558\uB3C4\uB85D! \uC190\uB2D8\uB4E4\uAED8\uB294 \uADF8\uB9BC\uC790\uB9CC
      \uD655\uC778\uD558\uACA0\uB2E4\uACE0 \uD574!"
  - speakerName: "\uBBF8\uB098"
    text: "\uD398\uD130, \uC77C\uB2E8 \uC228\uC73C\uC138\uC694!"
  - speakerName: "\uBBF8\uB098"
    text: "\uADF8... \uC5EC\uAE30 \uACC4\uC2E0 \uBD84\uB4E4\uC774 \uC81C \uB9D0\uC744
      \uB4E4\uC5B4\uC904\uC9C0 \uBAA8\uB974\uACA0\uC9C0\uB9CC..."
  - speakerName: "\uBBF8\uB098"
    text: "\uC77C\uB2E8 \uCD5C\uB300\uD55C \uC2DC\uC120\uC744 \uB04C\uC5B4\uBCFC\uAC8C\uC694."
  - speakerName: "\uBBF8\uB098"
    text: "\uC81C\uAC8C \uC2DC\uC120\uC774 \uB04C\uB9AC\uBA74 \uADF8\uB54C \uC870\uC6A9\uD788
      \uBE60\uC838\uB098\uAC08 \uC218 \uC788\uC744 \uAC70\uC608\uC694."
  - speakerName: 
    text: "\uD398\uD130\uB294 \uC8FC\uC704\uB97C \uB458\uB7EC\uBCF4\uC558\uB2E4.
      \uB4E4\uC5B4\uAC08 \uB9CC\uD55C \uC7A5\uC18C\uB294 \uB2E8 \uB450 \uACF3\uC774\uC5C8\uB2E4."
  - speakerName: 
    text: "\uADF8\uB294 \uB458\uB7EC\uBCF4\uB2E4\uAC00 \uD55C \uC7A5\uC18C\uB97C
      \uACE8\uB77C \uAE09\uD788 \uB4E4\uC5B4\uAC14\uB2E4."
