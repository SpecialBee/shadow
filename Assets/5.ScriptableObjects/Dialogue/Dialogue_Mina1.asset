  m_Script: {fileID: 11500000, guid: 43af71a745db8cf49984c234f252689c, type: 3}
  m_Name: Dialogue_Mina1
  m_EditorClassIdentifier: ShadowSeller::ShadowSeller.Core.DialogueData
  lines:
  - speakerName: 
    text: "\uD398\uD130\uAC00 \uC751\uC811\uC2E4\uC758 \uBB38\uC744 \uC5F4\uACE0
      \uB4E4\uC5B4\uAC00\uC790 \uC775\uC219\uD55C \uBAA8\uC2B5\uC758 \uC544\uAC00\uC528\uC640
      \uB9C8\uC8FC\uD558\uAC8C \uB418\uC5C8\uB2E4."
  - speakerName: 
    text: "\uC751\uC811\uC2E4 \uBCBD\uB09C\uB85C \uC55E\uC5D0\uC11C \uB178\uC744\uCC98\uB7FC
      \uBB3C\uB4E4\uC5B4 \uBD84\uC704\uAE30\uAC00 \uB0B4\uB824\uC549\uC544 \uC788\uB358
      \uBBF8\uB098\uB294 \uD398\uD130\uB97C \uBCF4\uB294 \uC21C\uAC04, \uADFC\uC2EC\uC774
      \uC2F9 \uC0AC\uB77C\uC9C4\uB4EF \uD65C\uAE30\uAC00 \uB3C8\uB2E4."
  - speakerName: "\uBBF8\uB098"
    text: "\uD398\uD130!"
  - speakerName: "\uB098"
    text: "\uBBF8\uB098, \uC815\uB9D0 \uC624\uB79C\uB9CC\uC774\uC57C."
