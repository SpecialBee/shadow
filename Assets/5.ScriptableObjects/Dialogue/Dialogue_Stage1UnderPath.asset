  m_Script: {fileID: 11500000, guid: 43af71a745db8cf49984c234f252689c, type: 3}
  m_Name: Dialogue_Stage1UnderPath
  m_EditorClassIdentifier: ShadowSeller::ShadowSeller.Core.DialogueData
  lines:
  - speakerName: "\uACBD\uBE44\uB300\uC7A5"
    text: "\uC77C\uB2E8 \uB098\uAC00\uB294 \uC0AC\uB78C\uB4E4\uC740 \uBAA8\uB450
      \uD655\uC778\uD558\uACE0 \uC800\uD0DD\uC740 \uCC9C\uCC9C\uD788 \uC218\uC0C9\uD55C\uB2E4!"
  - speakerName: "\uACBD\uBE44\uB300\uC7A5"
    text: "\uCD5C\uB300\uD55C \uC190\uB2D8\uBD84\uB4E4\uAED8 \uBD88\uD3B8\uD558\uC9C0
      \uC54A\uB3C4\uB85D \uC815\uC911\uD788! \uB300\uC2E0 \uC0C5\uC0C5\uC774 \uC218\uC0C9\uD574!"
  - speakerName: "\uACBD\uBE44\uB300\uC7A5"
    text: "\uADF8\uB9AC\uACE0 \uC2DD\uC0AC \uC900\uBE44\uB418\uBA74 \uC911\uC559
      \uBCF5\uB3C4\uBB38 \uC5F4\uC5B4\uB450\uB77C\uACE0 \uC8FC\uBC29\uC7A5\uD55C\uD14C
      \uB9D0\uD574\uB450\uACE0"
  - speakerName: "\uACBD\uBE44 1"
    text: "\uC608!"
  - speakerName: "\uB098"
    text: "\uC911\uC559 \uBCF5\uB3C4\uBB38 \uC5F4\uC1E0\uB294 \uC8FC\uBC29\uC7A5\uC5D0\uAC8C
      \uC788\uB098\uBCF4\uAD70."
  - speakerName: "\uB098"
    text: "\uC544\uB798\uB294 \uC6CC\uB099 \uACBD\uBE44\uAC00 \uB9CE\uC73C\uB2C8
      \uC911\uC559 \uBCF5\uB3C4\uB85C \uAC00\uB294 \uAC8C \uB0AB\uACA0\uC5B4."
