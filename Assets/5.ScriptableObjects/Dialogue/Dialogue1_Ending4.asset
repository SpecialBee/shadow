  m_Name: Dialogue1_Ending4
  m_EditorClassIdentifier: ShadowSeller::ShadowSeller.Core.DialogueData
  lines:
  - speakerName: 
    text: "\uC904\uC774 \uB04A\uC5B4\uC84C\uB2E4.\t"
  - speakerName: 
    text: "\uBE44\uBA85 \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4."
  - speakerName: 
    text: "\uD398\uD130\uB294 \uC544\uB798\uC5D0\uC11C \uBC8C\uC5B4\uC9C4 \uC77C\uC774
      \uC5B4\uB5A4 \uC77C\uC778\uC9C0 \uC54C\uACE0 \uC788\uC744\uAE4C?"
  - speakerName: 
    text: "\uC544\uB9C8 \uBAA8\uB97C \uAC83\uC774\uB2E4."
  - speakerName: 
    text: ... ...
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uC624, \uC774\uB7F0."
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uC0DD\uAC01\uBCF4\uB2E4 \uBE60\uB974\uAC8C \uC77C\uC774 \uBC8C\uC5B4\uC84C\uAD70\uC694."
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uC544\uC544, \uB2F9\uC2E0\uC758 \uC601\uD63C\uC774 \uC81C\uAC8C \uD55C
      \uBC1C\uC790\uAD6D \uAC00\uAE4C\uC6CC\uC9C0\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uB294\uAD70\uC694."
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uADF8\uB7FC \uB2E4\uC74C\uC5D0 \uB610 \uBD59\uC8E0, \uD398\uD130 \uC528."
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uAC00\uAE4C\uC6B4 \uC2DC\uC77C \uB0B4\uC5D0 \uB9D0\uC774\uC8E0."
