%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 43af71a745db8cf49984c234f252689c, type: 3}
  m_Name: Dialogue_Baron
  m_EditorClassIdentifier: ShadowSeller::ShadowSeller.Core.DialogueData
  lines:
  - speakerName: 
    text: "\uBC29\uC740 \uACE0\uC694\uD558\uB2E4. \uCC3D\uAC00\uC5D0\uB294 \uD55C
      \uB0A8\uC790\uAC00 \uC11C\uC11C \uB2F4\uBC30 \uC5F0\uAE30\uB85C \uBC29\uC744
      \uCC44\uC6B0\uACE0 \uC788\uC5C8\uB2E4."
  - speakerName: ???
    text: "\uB4E4\uC5B4\uC624\uC2DC\uC624, \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC18C."
  - speakerName: "\uB098"
    text: "... \uC800\uB97C \uAE30\uB2E4\uB838\uB2E4\uACE0\uC694?"
  - speakerName: "\uBC31\uC791"
    text: "\uB0B4\uAC00 \uACBD\uBE44\uB4E4\uC5D0\uAC8C \uC7A1\uC544\uC624\uB77C\uACE0
      \uBA85\uB839\uD588\uC18C. \uC5B4\uCC28\uD53C \uC7A1\uD614\uC5B4\uB3C4, \uC774\uB807\uAC8C
      \uB9CC\uB0AC\uC744 \uAC70\uC694. \uB9CC\uB098\uC11C \uBC18\uAC11\uC18C, \uB77C\uC2A4\uCE7C
      \uBC31\uC791\uC774\uB77C \uBD80\uB974\uC2DC\uC624. \uC544\uB2C8\uBA74... "
  - speakerName: 
    text: "\uB0A8\uC790\uB294 \uCC9C\uCC9C\uD788 \uB3CC\uC544\uC130\uB2E4."
  - speakerName: 
    text: "\uC57D\uD55C \uC870\uBA85\uC5D0 \uC758\uD574 \uADF8\uC758 \uC5BC\uAD74\uC774
      \uCC9C\uCC9C\uD788 \uB4DC\uB7EC\uB09C\uB2E4."
  - speakerName: 
    text: "\uD398\uD130\uB294 \uADF8\uC758 \uC5BC\uAD74\uC744 \uBCF4\uC790 \uC228\uC774
      \uBA4E\uB294 \uB4EF\uD588\uB2E4. \uB108\uBB34\uB098\uB3C4 \uC775\uC219\uD55C
      \uC5BC\uAD74\uC774\uC5C8\uB2E4."
  - speakerName: "\uB098"
    text: "\uB2F9\uC2E0\uC740..."
  - speakerName: "\uBC31\uC791"
    text: "\uAE30\uC5B5\uD558\uC2DC\uB294\uAD70. \uAE30\uC5B5\uD558\uC9C0 \uBABB\uD588\uC73C\uBA74
      \uC12D\uC12D\uD560 \uBED4 \uD588\uC18C."
  - speakerName: "\uBC31\uC791"
    text: "\uB098\uC694, \uB2F9\uC2E0\uC758 \uADF8\uB9BC\uC790\uB97C \uC0AC\uAC04
      \uB0A8\uC790."
  - speakerName: "\uB098"
    text: "\uD68C\uC0C9 \uC637\uC744 \uC785\uC740 \uB0A8\uC790..."
  - speakerName: "\uB098"
    text: "... \uB3CC\uB824\uC8FC\uC2DC\uC624, \uB0B4 \uADF8\uB9BC\uC790!"
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uC5B4\uD5C8, \uC54C \uB9CC\uD55C \uC0AC\uB78C\uC774 \uC65C \uADF8\uB9AC
      \uB5BC\uB97C \uC4F0\uB294\uAC8C\uC694?"
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uAC70\uB798\uB294 \uAC70\uB798\uC694, \uB2E4\uB9CC... \uBC29\uBC95\uC774
      \uC5C6\uB294 \uAC74 \uC544\uB2C8\uC9C0."
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uB2F9\uC2E0\uC758 \uC601\uD63C\uC744 \uB0B4\uAC8C \uB118\uAE34\uB2E4\uBA74,
      \uADF8\uB9BC\uC790\uB97C \uB3CC\uB824\uB4DC\uB9AC\uACA0\uC18C."
  - speakerName: "\uB098"
    text: "... \uADF8\uAC74 \uC2EB\uC18C."
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uC5ED\uC2DC, \uADF8\uB7F4 \uC904 \uC54C\uC558\uC18C."
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uAC70\uB798\uB97C \uD558\uC9C0 \uC54A\uACA0\uB2E4\uBA74 \uC774\uACF3\uC5D0
      \uB354 \uC788\uC744 \uC774\uC720\uB294 \uC5C6\uACA0\uC9C0."
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uB0B4 \uACE0\uAC1D\uC774 \uACE4\uACBD\uC5D0 \uCC98\uD558\uB294 \uAC78
      \uC990\uAE30\uC9C4 \uC54A\uC73C\uB2C8 \uB3C4\uC640\uB4DC\uB9AC\uB3C4\uB85D
      \uD558\uACA0\uC18C."
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uB2E8, \uB0B4 \uBD80\uD0C1 \uD558\uB098\uB97C \uB4E4\uC5B4\uC8FC\uC5B4\uC57C
      \uD558\uC624."
  - speakerName: "\uB098"
    text: "\uBD80\uD0C1\uC774\uB77C\uB2C8?"
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uC774 \uBC29\uACFC \uAC00\uAE4C\uC6B4 \uBA54\uC778 \uD640, \uBC29\uAE08
      \uACBD\uBE44\uB4E4\uC774 \uC628 \uACF3\uC744 \uC54C \uAC83\uC774\uC624."
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uC911\uC559 \uBCF5\uB3C4\uC758 \uBD81\uCABD\uC73C\uB85C \uC62C\uB77C\uAC00\uBA74
      \uBA54\uC778 \uD640\uC774\uC694. \uACBD\uBE44\uB4E4\uC740 \uB0A8\uCABD\uC5D0
      \uBAB0\uB824 \uC788\uC744 \uD14C\uACE0 \uC190\uB2D8\uB4E4\uB3C4 \uC801\uC744\uD14C\uB2C8
      \uC27D\uAC8C \uB4E4\uC5B4\uAC08 \uC218 \uC788\uC744 \uAC70\uC694."
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uADF8 \uBA54\uC778 \uD640\uC758 \uC0F9\uB4E4\uB9AC\uC5D0,"
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uC0F9\uB4E4\uB9AC\uC5D0\uC758 \uC904\uC744 \uB04A\uC5B4\uC8FC\uC2DC\uC624."
  - speakerName: "\uB098"
    text: "... \uBB50?"
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uB9D0\uD588\uB4EF \uC904\uC744 \uB04A\uC73C\uBA74 \uB418\uC624. \uB04A\uC744
      \uC218\uB2E8\uB3C4 \uADF8 \uACF3\uC5D0 \uC788\uC744 \uAC70\uC694."
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uB2F9\uC2E0\uC774 \uB4E4\uD0A4\uC9C0 \uC54A\uACE0 \uB098\uAC00\uB824\uBA74
      \uC774 \uC18C\uB780\uBCF4\uB2E4 \uB354 \uD070 \uC18C\uB780\uC744 \uB9CC\uB4E4\uC5B4\uC57C
      \uD558\uC9C0 \uC54A\uACA0\uC18C?"
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uC0F9\uB4E4\uB9AC\uC5D0\uAC00 \uB5A8\uC5B4\uC9C0\uACE0 \uC18C\uB780\uC2A4\uB7EC\uC6CC\uC9C0\uBA74
      2\uCE35 \uC815\uC6D0\uC73C\uB85C \uB098\uAC00\uC2DC\uC624."
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uC815\uC6D0\uC758 \uD0A4\uB294 \uC0F9\uB4E4\uB9AC\uC5D0 \uADFC\uCC98
      \uC5F4\uC1E0 \uBCF4\uAD00\uD568\uC5D0 \uC788\uC744 \uAC70\uC694."
  - speakerName: "\uD68C\uC0C9 \uB0A8\uC790"
    text: "\uC774 \uC815\uB3C4\uB294 \uD560 \uC218 \uC788\uC9C0 \uC54A\uC18C, \uD398\uD130
      \uC290\uB808\uBC00 \uC528?"
  - speakerName: "\uB098"
    text: "... \uC54C\uACA0\uC18C."
