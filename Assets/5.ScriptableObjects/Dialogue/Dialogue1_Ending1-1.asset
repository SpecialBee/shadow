%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 43af71a745db8cf49984c234f252689c, type: 3}
  m_Name: Dialogue1_Ending1-1
  m_EditorClassIdentifier: ShadowSeller::ShadowSeller.Core.DialogueData
  lines:
  - speakerName: 
    text: "\uC6C5\uC131\uAC70\uB9BC\uC774 \uB4E4\uB9B0\uB2E4."
  - speakerName: 
    text: "\uC77C\uBD80 \uC190\uB2D8\uB4E4\uC774 \uBA54\uC778 \uD640\uC5D0 \uB4E4\uC5B4\uC628\uB2E4."
  - speakerName: "\uB6B1\uB6B1\uD55C \uB0A8\uC790"
    text: "\uC544\uBB34\uB9AC \uADF8\uB798\uB3C4 \uBCA0\uB974\uD06C \uC591... \uADF8\uB9BC\uC790\uAC00
      \uC5C6\uB294 \uC0AC\uB78C\uC740..."
  - speakerName: "\uD0A4 \uD070 \uC5EC\uC790"
    text: "\uC545\uB9C8\uC8E0! \uBD84\uBA85 \uC545\uB9C8\uC785\uB2C8\uB2E4!"
  - speakerName: "\uB9C8\uB978 \uB0A8\uC790"
    text: "\uC0AC\uB78C\uC5D0\uAC8C \uADF8\uB9BC\uC790\uAC00 \uC5C6\uB2E4\uB294 \uAC74
      \uC0C1\uC0C1\uD560 \uC218\uAC00 \uC5C6\uC8E0. \uC545\uB9C8\uAC70\uB098 \uC801\uC5B4\uB3C4
      \uADF8\uC640 \uBE44\uC2B7\uD55C \uBB34\uC5B8\uAC00\uC77C \uAC81\uB2C8\uB2E4."
  - speakerName: "\uBBF8\uB098"
    text: "\uC815\uB9D0 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uC2DC\uB098\uC694?"
  - speakerName: "\uBBF8\uB098"
    text: "\uC5EC\uB7EC\uBD84\uC740 \uADF8\uB9BC\uC790\uAC00 \uC5C6\uB294 \uC0AC\uB78C\uC744
      \uBCF8 \uC801 \uC788\uC73C\uC2E0\uAC00\uC694?"
  - speakerName: "\uBBF8\uB098"
    text: "\uBAA8\uB450\uB4E4 \uC624\uB298 \uCC98\uC74C \uBCF4\uC168\uC744 \uAC70\uB77C\uACE0
      \uC0DD\uAC01\uD574\uC694."
  - speakerName: "\uBBF8\uB098"
    text: "\uD558\uC9C0\uB9CC \uADF8\uAC00 \uB204\uAD70\uAC00\uB97C \uD574\uCCE4\uB098\uC694?
      \uBB34\uC5B8\uAC00\uB97C \uD6D4\uCCE4\uB098\uC694?"
  - speakerName: "\uBBF8\uB098"
    text: "\uC81C\uAC00 \uBCF8 \uADF8\uB9BC\uC790\uAC00 \uC5C6\uB294 \uC0AC\uB098\uC774\uB294
      \uAC81\uC5D0 \uC9C8\uB824 \uB3C4\uB9DD\uCE58\uB358 \uD55C \uC0AC\uB78C\uC758
      \uB4B7\uBAA8\uC2B5 \uBFD0\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
  - speakerName: "\uBBF8\uB098"
    text: "\uADF8\uB9BC\uC790\uAC00 \uC5C6\uB294 \uC0AC\uB78C\uC774\uB77C\uACE0...
      \uC0AC\uB78C\uC758 \uB9C8\uC74C\uB3C4 \uC0AC\uB77C\uC9C0\uB098\uC694?"
  - speakerName: "\uBBF8\uB098"
    text: "\uC800\uB294... \uADF8 \uC0AC\uB78C\uC744 \uC54C\uACE0 \uC788\uC2B5\uB2C8\uB2E4..."
  - speakerName: 
    text: "\uC0AC\uB78C\uB4E4 \uC0AC\uC774\uC5D0\uC11C \uC791\uC740 \uC18C\uB780\uC774
      \uC77C\uC5C8\uB2E4."
  - speakerName: "\uBBF8\uB098"
    text: "\uC5B4\uB9B4 \uB54C\uBD80\uD130 \uC54C\uB358 \uC0AC\uB78C\uC774\uC5C8\uC5B4\uC694.
      \uB2E4\uC815\uD558\uAE30\uB3C4 \uD558\uACE0, \uC2E0\uC911\uD55C \uC0AC\uB78C\uC774\uAE30\uB3C4
      \uD588\uC8E0."
  - speakerName: "\uBBF8\uB098"
    text: "\uADF8\uB7F0 \uC0AC\uB78C\uC774 \uD558\uB8E8\uC544\uCE68\uC5D0 \uC545\uB9C8\uAC00
      \uB418\uC5C8\uB2E4\uACE0 \uBBFF\uC73C\uC2DC\uB098\uC694?"
  - speakerName: "\uBBF8\uB098"
    text: "\uC5B4\uCA4C\uBA74... \uC783\uC5B4\uBC84\uB9B0 \uAC78\uC9C0\uB3C4 \uBAB0\uB77C\uC694."
  - speakerName: "\uBBF8\uB098"
    text: "\uADF8\uB9AC\uACE0 \uADF8 \uC783\uC5B4\uBC84\uB9B0 \uAC83 \uB54C\uBB38\uC5D0,
      \uC774\uB807\uAC8C \uCAD3\uAE30\uACE0 \uC788\uB294 \uAC70\uB77C\uBA74"
  - speakerName: "\uBBF8\uB098"
    text: "\uC6B0\uB9AC\uAC00 \uD574\uC57C \uD560 \uC77C\uC740 \uADF8\uB97C \uBD99\uC7A1\uACE0
      \uC190\uAC00\uB77D\uC9C8 \uD558\uB294 \uAC8C \uC544\uB2C8\uB77C..."
