  m_Script: {fileID: 11500000, guid: 43af71a745db8cf49984c234f252689c, type: 3}
  m_Name: Dialogue_SubQuest1
  m_EditorClassIdentifier: ShadowSeller::ShadowSeller.Core.DialogueData
  lines:
  - speakerName: "\uD558\uC778"
    text: "\uC694\uC0C8 \uC774\uB7F0 \uD30C\uD2F0\uB97C \uBD80\uCA4D \uB9CE\uC774
      \uC5EC\uC2DC\uB294\uAD70."
  - speakerName: "\uD558\uC778"
    text: "\uC77C\uBD80\uB7EC \uAC00\uB09C\uD55C \uADC0\uC871\uC774\uB098 \uADFC\uCC98
      \uC8FC\uBBFC\uC744 \uB530\uB85C \uB9CC\uB098\uB294 \uC77C\uB3C4 \uC880 \uC7A6\uC544\uC9C0\uC2E0
      \uAC83 \uAC19\uACE0..."
  - speakerName: "\uD558\uC778"
    text: "\uB3C8\uC774 \uB0A8\uC544\uB098\uC2DC\uB824\uB098? \uBD09\uAE09\uC744
      \uBABB \uBC1B\uC73C\uBA74 \uC548 \uB418\uB294\uB370..."
  - speakerName: "\uB098"
    text: "\uC77C\uBD80\uB7EC \uAC00\uB09C\uD55C \uADC0\uC871\uC774\uB098 \uADFC\uCC98
      \uC8FC\uBBFC\uC744 \uB530\uB85C \uB9CC\uB09C\uB2E4\uACE0?"
  - speakerName: "\uB098"
    text: "\uADF8\uB7F4 \uD544\uC694\uAC00 \uC788\uB294 \uAC74\uAC00? \uC801\uC120\uC774\uB77C\uB3C4
      \uD558\uACE0 \uB2E4\uB2C8\uB294 \uAC74\uAC00?"
  - speakerName: "\uB098"
    text: "\uC544\uB2C8\uBA74 \uB098\uCC98\uB7FC \uAC11\uC791\uC2A4\uB7FD\uAC8C \uB3C8\uC774
      \uB9CE\uC544\uC84C\uB2E4\uBA74..."
