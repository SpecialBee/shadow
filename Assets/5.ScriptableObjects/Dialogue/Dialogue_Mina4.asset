  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 43af71a745db8cf49984c234f252689c, type: 3}
  m_Name: Dialogue_Mina4
  m_EditorClassIdentifier: ShadowSeller::ShadowSeller.Core.DialogueData
  lines:
  - speakerName: "\uBBF8\uB098"
    text: "... \uADF8\uB798\uB3C4..."
  - speakerName: "\uBBF8\uB098"
    text: "\uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uCAD3\uAE30\uBA74\uC11C\uB3C4 \uC774\uB807\uAC8C
      \uC808 \uCC3E\uC544\uC624\uC168\uC796\uC544\uC694."
  - speakerName: "\uBBF8\uB098"
    text: "\uADF8\uB9BC\uC790\uAC00 \uC5C6\uB294 \uC0AC\uB78C\uC774 \uC545\uB9C8\uB77C\uBA74...
      \uC65C \uB3C4\uB9DD\uCE58\uC9C0 \uC54A\uACE0 \uC800\uB97C \uCC3E\uC544 \uC5EC\uAE30\uAE4C\uC9C0
      \uC654\uACA0\uC5B4\uC694?"
  - speakerName: "\uB098"
    text: "\uBBF8\uB098..."
  - speakerName: "\uBBF8\uB098"
    text: "\uC800\uB97C \uCC3E\uC544\uC628 \uAC8C... \uB9DE\uC73C\uC2E0\uAC70\uC8E0?"
  - speakerName: "\uB098"
    text: "... \uBB3C\uB860."
  - speakerName: 
    text: "\uBB54\uAC00\uB97C \uACE0\uBBFC\uD558\uB4EF \uC2DC\uC120\uC744 \uBC14\uB2E5\uC73C\uB85C
      \uB5A8\uAD6C\uB294 \uADF8\uB140\uC600\uB2E4."
  - speakerName: 
    text: "\uADF8\uB140\uB294 \uACE7 \uACB0\uC2EC\uD55C\uB4EF \uD398\uD130\uC758
      \uB208\uC744 \uB611\uBC14\uB85C \uBC14\uB77C\uBCF8\uB2E4."
  - speakerName: "\uBBF8\uB098"
    text: "\uB2F9\uC2E0\uC774 \uADF8\uB9BC\uC790\uAC00 \uC5C6\uB294 \uC0AC\uB78C\uC778\uC9C0
      \uC0AC\uB78C\uB4E4\uC740 \uC798 \uC54C\uC9C0 \uBABB\uD560 \uAC70\uC608\uC694."
  - speakerName: "\uBBF8\uB098"
    text: "\uBD84\uBA85 \uB2F9\uC2E0\uC758 \uC5BC\uAD74\uC744 \uBCF4\uB294 \uAC83\uB9CC\uC73C\uB85C\uB294
      \uC54C\uC9C0 \uBABB\uD560 \uD14C\uB2C8\uAE4C..."
  - speakerName: "\uBBF8\uB098"
    text: "\uB098\uAC08 \uBC29\uBC95\uC744 \uCC3E\uC544\uBD10\uC694! \uC800\uB3C4
      \uB3C4\uC640\uB4DC\uB9B4\uAC8C\uC694!"
