  m_Name: Dialogue1_Ending1
  m_EditorClassIdentifier: ShadowSeller::ShadowSeller.Core.DialogueData
  lines:
  - speakerName: 
    text: "\uBA54\uC778 \uD640\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uD55C\uC0B0\uD588\uB2E4."
  - speakerName: 
    text: "\uAE38\uC744 \uB9C9\uACE0 \uC788\uB358 \uACBD\uBE44\uB4E4\uB3C4 \uBCF4\uC774\uC9C0
      \uC54A\uC558\uB2E4."
  - speakerName: 
    text: "\uD398\uD130\uB294 \uCC9C\uC7A5\uC758 \uC0F9\uB4E4\uB9AC\uC5D0\uB97C \uC62C\uB824\uB2E4\uBD24\uB2E4.
      \uC774\uB300\uB85C \uB5A8\uC5B4\uC9C0\uBA74 \uC544\uBB34\uB3C4 \uB2E4\uCE58\uC9C4
      \uC54A\uC73C\uB9AC\uB77C."
  - speakerName: 
    text: "\uBC31\uC791\uC740 \uC65C \uC774\uB7EC\uD55C \uC870\uAC74\uC744 \uAC74
      \uAC83\uC77C\uAE4C?"
  - speakerName: 
    text: "\uB098\uC05C \uC9D3\uC774\uB77C\uB3C4 \uD558\uAE38 \uBC14\uB780 \uAC83\uC77C\uAE4C?"
  - speakerName: 
    text: "\uD398\uD130\uB294 \uADF8\uC758 \uC9C4\uC758\uB97C \uCD94\uCE21\uD574\uBCF4\uC558\uC9C0\uB9CC
      \uC7A1\uD788\uB294 \uBD80\uBD84\uC774 \uC5C6\uC5C8\uB2E4."
  - speakerName: 
    text: ... ...
