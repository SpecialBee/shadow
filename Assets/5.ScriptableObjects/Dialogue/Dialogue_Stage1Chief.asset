  m_Script: {fileID: 11500000, guid: 43af71a745db8cf49984c234f252689c, type: 3}
  m_Name: Dialogue_Stage1Chief
  m_EditorClassIdentifier: ShadowSeller::ShadowSeller.Core.DialogueData
  lines:
  - speakerName: "\uC8FC\uBC29\uC7A5"
    text: "\uC544... \uC77C\uD558\uAE30 \uC2EB\uB2E4. \uC774 \uB3C8\uC744 \uBC1B\uC73C\uBA74\uC11C
      \uC77C\uD574\uC57C \uD558\uB098?"
  - speakerName: 
    text: "\uADF8\uB294 \uBAA9\uC7AC \uC2DD\uD0C1\uC5D0 \uC5CE\uB4DC\uB824 \uC790\uC2E0\uC758
      \uC0B6\uC744 \uD55C\uD0C4\uD558\uACE0 \uC788\uB2E4. "
  - speakerName: 
    text: "\uADF8\uC758 \uD5C8\uB9AC\uCDA4\uC5D0 \uB179\uC2A8 \uAE08\uC18D \uC5F4\uC1E0
      \uAFB8\uB7EC\uBBF8\uAC00 \uBCF4\uC778\uB2E4."
  - speakerName: 
    text: "\uD398\uD130\uB294 \uADF8\uC758 \uC606\uC5D0 \uC870\uC2EC\uD788 \uCABC\uADF8\uB824
      \uC549\uC544"
  - speakerName: 
    text: "\uADF8\uC758 \uC5F4\uC1E0 \uAFB8\uB7EC\uBBF8\uB97C \uCC9C\uCC9C\uD788
      \uD5C8\uB9AC\uCDA4\uC5D0\uC11C \uBE7C\uB0B4\uC5C8\uB2E4."
  - speakerName: 
    text: "\uC8FC\uBC29\uC7A5\uC740 \uC5EC\uC804\uD788 \uB208\uCE58\uCC44\uC9C0 \uBABB\uD55C
      \uB4EF \uBCF4\uC778\uB2E4."
  - speakerName: "\uB098"
    text: "\uACE7 \uB3CC\uB824\uC8FC\uACA0\uC18C."
