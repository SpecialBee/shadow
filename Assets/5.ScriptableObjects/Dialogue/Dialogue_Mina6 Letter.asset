  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 43af71a745db8cf49984c234f252689c, type: 3}
  m_Name: Dialogue_Mina6 Letter
  m_EditorClassIdentifier: ShadowSeller::ShadowSeller.Core.DialogueData
  lines:
  - speakerName: 
    text: "\uCC45\uC0C1 \uC704\uC5D0 \uB0A1\uC740 \uD3B8\uC9C0 \uBA87 \uC7A5\uC774
      \uD769\uC5B4\uC838 \uC788\uB2E4."
  - speakerName: 
    text: "\uB204\uAD6C \uAC83\uC778\uC9C0\uB294 \uBAA8\uB974\uC9C0\uB9CC \uD3B8\uC9C0
      \uB0B4\uC6A9\uC774 \uC790\uC5F0\uC2A4\uB7FD\uAC8C \uB208\uC5D0 \uB4E4\uC5B4\uC654\uB2E4."
  - speakerName: 
    text: "\u300C\uADF8 \uC0AC\uB0B4\uB97C \uB9CC\uB09C \uB4A4\uB85C \uBAA8\uB4E0
      \uAC83\uC774 \uC190\uC5D0 \uB4E4\uC5B4\uC654\uB2E4.\u300D"
  - speakerName: 
    text: "\u300C\uADF8\uB7EC\uB098 \uACB0\uAD6D \uB0B4\uAC8C \uB0A8\uC740 \uAC83\uC740
      \uC5C6\uC5C8\uB2E4.\u300D"
  - speakerName: 
    text: "\u300C\uD639\uC2DC \uADF8 \uC0AC\uB0B4\uB97C \uB9CC\uB2E8\uB2E4\uBA74
      \uBB34\uC5C7\uC744 \uAD8C\uD558\uB4E0 \uBC18\uB4DC\uC2DC \uAC70\uC808\uD574\uC57C
      \uD55C\uB2E4.\u300D"
  - speakerName: 
    text: "\u300C\uD68C...\u300D"
  - speakerName: 
    text: "\uAE00\uC528\uAC00 \uB04A\uACA8 \uC788\uB2E4. \uD3B8\uC9C0\uB97C \uC801\uB2E4
      \uB9CC \uAC83\uC73C\uB85C \uBCF4\uC778\uB2E4."
  - speakerName: 
    text: "\uD398\uD130\uB294 \uD55C\uB3D9\uC548 \uD3B8\uC9C0\uB97C \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4."
  - speakerName: "\uBBF8\uB098"
    text: "\uD398\uD130, \uC65C \uADF8\uB798\uC694?"
